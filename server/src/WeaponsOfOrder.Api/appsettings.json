{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WeaponsOfOrder": ""
  },
  "Auth": {
    "RequireConfirmedEmailForSignIn": true,
    "ClientBaseUrl": "",
    "Password": {
      "RequiredLength": 12,
      "RequiredUniqueChars": 4,
      "RequireDigit": false,
      "RequireLowercase": false,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "Cookie": {
      "Name": "woo.session",
      "LifetimeDays": 14
    },
    "RateLimit": {
      "Login": { "PermitLimit": 10, "WindowMinutes": 5 },
      "Registration": { "PermitLimit": 5, "WindowMinutes": 15 },
      "Sensitive": { "PermitLimit": 5, "WindowMinutes": 15 }
    },
    "Development": {
      "ExposeNotifications": false
    }
  }
}
