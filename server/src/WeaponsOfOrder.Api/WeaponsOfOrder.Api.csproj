<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>WeaponsOfOrder.Api</RootNamespace>
    <UserSecretsId>weapons-of-order-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The account options, their validator and the link factory are internal on purpose;
         the test project asserts on them directly rather than through a widened API. -->
    <InternalsVisibleTo Include="WeaponsOfOrder.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Account email delivery in deployed environments. Authenticated with the App
         Service managed identity where one is available, so no provider secret has to
         exist; a connection string is accepted as a fallback. -->
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Identity" />
    <!-- Application Insights through the current OpenTelemetry-based distro rather than
         the legacy Microsoft.ApplicationInsights.AspNetCore SDK. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <!-- Referenced directly because a span processor is registered against it; without
         this the dependency would be an accident of the distro's own graph. -->
    <PackageReference Include="OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaponsOfOrder.Infrastructure\WeaponsOfOrder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept out of the deployment artifact. It holds the local development database
         credentials, and a deployed environment never loads it anyway - shipping it would
         only put a connection string somewhere it has no reason to be. It still copies to
         the build output, so `dotnet run` is unaffected. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Creator-authored game content. It lives at server/content so it reads as content
         rather than as another settings file, and is copied beside the built application so a
         published deployment carries it. During development the repository copy is what the
         API reads, so an edit there takes effect without a rebuild. -->
    <Content Include="..\..\content\**\*.json" Link="content\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
