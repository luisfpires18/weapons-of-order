<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>WeaponsOfOrder.Api</RootNamespace>
    <UserSecretsId>weapons-of-order-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The account options, their validator and the link factory are internal on purpose;
         the test project asserts on them directly rather than through a widened API. -->
    <InternalsVisibleTo Include="WeaponsOfOrder.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaponsOfOrder.Infrastructure\WeaponsOfOrder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Creator-authored game content. It lives at server/content so it reads as content
         rather than as another settings file, and is copied beside the built application so a
         published deployment carries it. During development the repository copy is what the
         API reads, so an edit there takes effect without a rebuild. -->
    <Content Include="..\..\content\**\*.json" Link="content\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
